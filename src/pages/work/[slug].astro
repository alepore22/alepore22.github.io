---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';

export async function getStaticPaths() {
  const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: work[(i + 1) % work.length] },
  }));
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<Base title={`${d.title} · ${d.category}, Angelo Lepore`} description={d.summary} barTone={d.color} barInk={d.ink}>
  <article class="project" style={`--tile:${d.color};--tile-ink:${d.ink}`}>
    <header class="head">
      <div class="head-text" data-reveal>
        <h1 class="display">{d.title}</h1>
        <p class="summary">{d.summary}</p>
        <p class="meta-row"><span>{d.category}</span><span>{d.date}</span></p>
      </div>
      <figure class="cover" data-reveal>
        <Image src={d.cover} alt={d.coverAlt} widths={[800, 1400, 1920]} sizes="(max-width: 900px) 100vw, 55vw" loading="eager" style={`object-position:${d.coverPosition}`} />
      </figure>
    </header>

    <div class="body">
      <dl class="meta" data-reveal>
        <div><dt>Quando</dt><dd>{d.date}</dd></div>
        <div><dt>Cosa</dt><dd>{d.category}</dd></div>
        {d.role && <div><dt>Ruolo</dt><dd>{d.role}</dd></div>}
        {d.with && <div><dt>Con</dt><dd>{d.with}</dd></div>}
        {d.tools.length > 0 && <div><dt>Strumenti</dt><dd>{d.tools.join(', ')}</dd></div>}
      </dl>
      <div class="prose" data-reveal>
        <h2 class="prose-title">Il progetto</h2>
        <Content />
        {d.behance && <p class="full"><a class="text-link" href={d.behance}>Il progetto completo su Behance</a></p>}
      </div>
    </div>

    <nav class="next" aria-label="Progetto successivo" data-reveal>
      <h2 class="hand next-label">Prossimo progetto</h2>
      <Arrow down />
      <a class="display" href={`/work/${next.id}/`}>{next.data.title}</a>
      <p class="back"><a href="/#work">Torna a tutti i progetti</a></p>
    </nav>
  </article>
</Base>

<style>
  .head {
    background: var(--tile); color: var(--tile-ink);
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: clamp(32px, 4vw, 72px); align-items: end;
    padding: clamp(32px, 6vh, 80px) var(--margin) var(--margin);
  }
  .head-text { padding-bottom: clamp(8px, 2vw, 24px); }
  h1 { font-size: clamp(3.25rem, 1rem + 7vw, 9rem); line-height: 0.9; text-wrap: balance; overflow-wrap: anywhere; }
  .summary { margin-top: 28px; max-width: 34ch; font-size: var(--step-lead); line-height: 1.4; }
  .meta-row { margin-top: 32px; display: flex; gap: 24px; font-size: var(--step-small); font-weight: 600; }
  .cover { aspect-ratio: 16 / 10; border-radius: var(--radius); overflow: hidden; }
  .cover :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .body {
    display: grid; grid-template-columns: minmax(160px, 16vw) minmax(0, 1fr);
    gap: clamp(32px, 4vw, 64px); padding: clamp(64px, 8vw, 120px) var(--margin) 0;
  }
  .meta { display: grid; gap: 18px; font-size: var(--step-small); align-content: start; position: sticky; top: 32px; }
  .meta dt { color: var(--muted); }
  .meta dd { font-weight: 600; }
  .prose { display: grid; gap: 1.2em; align-content: start; }
  .prose > :global(*:not(:has(img))) { max-width: 62ch; }
  .prose :global(h2) { font-family: var(--display); font-weight: 400; font-size: clamp(1.75rem, 1.3rem + 1.4vw, 2.75rem); line-height: 1; margin-top: 1.2em; }
  .prose .prose-title { margin-top: 0; }
  .prose :global(p) { font-size: var(--step-lead); line-height: 1.5; }
  .prose :global(p:has(img)) { margin: 0.8em 0; }
  .prose :global(img) { width: 100%; height: auto; border-radius: calc(var(--radius) - 8px); }
  /* Several pictures in one paragraph become a grid; four or more (phone screens, wallpapers) a tighter one. */
  .prose :global(p:has(img + img)) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(12px, 1.6vw, 24px); }
  .prose :global(p:has(> img:nth-of-type(4))) { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .full { margin-top: 0.6em; }

  .next {
    margin-top: var(--gap-section); padding: 0 var(--margin);
    display: flex; flex-direction: column; align-items: center; text-align: center;
  }
  .next-label { color: var(--lav-deep); }
  .next :global(.arrow) { color: var(--lav-deep); margin: 4px 0; }
  .next > a {
    font-size: clamp(3rem, 1rem + 8vw, 9rem); line-height: 0.95; text-decoration: none;
    transition: color 180ms var(--ease), transform 300ms var(--ease);
  }
  .next > a:hover { color: var(--lav-deep); transform: scale(1.03) rotate(-1deg); }
  .back { margin-top: 28px; font-size: var(--step-small); font-weight: 600; }
  .back a:hover { color: var(--lav-deep); }

  @media (max-width: 900px) {
    .head { grid-template-columns: 1fr; }
    .body { grid-template-columns: 1fr; }
    .meta { grid-template-columns: 1fr 1fr; position: static; order: 2; }
    .prose :global(p:has(> img:nth-of-type(4))) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
