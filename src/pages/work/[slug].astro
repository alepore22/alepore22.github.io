---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import DemonSwarm from '../../components/DemonSwarm.astro';

export async function getStaticPaths() {
  const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: work[(i + 1) % work.length] },
  }));
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const n = next.data;
---

<Base
  title={`${d.title} · ${d.category}, Angelo Lepore`}
  description={d.summary}
  barTone={d.color}
  barInk={d.ink}
  footTone={n.color}
  footInk={n.ink}
  current="work"
>
  <article class="project" style={`--tile:${d.color};--tile-ink:${d.ink}`}>
    <header class="head">
      <div class="head-text" data-reveal>
        <h1 class="display">{d.title}</h1>
        <p class="summary">{d.summary}</p>
        <dl class="facts">
          <div><dt>Quando</dt><dd>{d.date}</dd></div>
          <div><dt>Cosa</dt><dd>{d.category}</dd></div>
          {d.role && <div><dt>Ruolo</dt><dd>{d.role}</dd></div>}
          {d.with && <div><dt>Con</dt><dd>{d.with}</dd></div>}
          {d.tools.length > 0 && <div><dt>Strumenti</dt><dd>{d.tools.join(', ')}</dd></div>}
        </dl>
      </div>
      <figure class:list={['cover', { 'cover--video': d.video, 'cover--swarm': entry.id === 'demons' }]} transition:name={`media-${entry.id}`}>
        {entry.id === 'demons' ? (
          <DemonSwarm />
        ) : d.video ? (
          <video src={d.video} poster={d.cover.src} autoplay muted loop playsinline preload="metadata" aria-label={d.coverAlt} />
        ) : (
          <Image src={d.cover} alt={d.coverAlt} widths={[800, 1400, 2000]} sizes="(max-width: 900px) 100vw, 55vw" loading="eager" style={`object-position:${d.coverPosition}`} />
        )}
      </figure>
    </header>

    <div class="prose" data-reveal>
      <Content />
      {d.behance && <p class="full"><a class="button" href={d.behance}>Vedi il progetto su Behance</a></p>}
    </div>

    <nav class="next" aria-label="Progetto successivo" style={`--tile:${n.color};--tile-ink:${n.ink}`}>
      <a href={`/work/${next.id}/`}>
        <span class="next-text">
          <span class="hand">Prossimo progetto</span>
          <span class="display next-title">{n.title}</span>
          <span class="next-summary">{n.summary}</span>
        </span>
        <span class="next-pic">
          <Image src={n.cover} alt="" widths={[480, 800]} sizes="(max-width: 900px) 100vw, 40vw" style={`object-position:${n.coverPosition}`} />
        </span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .head {
    background: var(--tile); color: var(--tile-ink);
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: clamp(32px, 4vw, 72px); align-items: end;
    padding: clamp(24px, 5vh, 72px) var(--margin) var(--margin);
  }
  .head-text { padding-bottom: clamp(8px, 2vw, 24px); }
  h1 { font-size: clamp(3.25rem, 1rem + 7vw, 9rem); line-height: 0.9; text-wrap: balance; overflow-wrap: anywhere; }
  .summary { margin-top: 28px; max-width: 34ch; font-size: var(--step-lead); line-height: 1.4; }
  .facts { margin-top: 36px; display: flex; flex-wrap: wrap; gap: 16px 36px; font-size: var(--step-small); }
  .facts dt { opacity: 0.75; }
  .facts dd { font-weight: 600; }
  .cover { aspect-ratio: 16 / 10; border-radius: var(--radius); overflow: hidden; }
  .cover :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .cover--video { display: grid; place-items: center; }
  .cover--video video { height: 100%; width: auto; border-radius: 28px; }

  /* The case study. Text keeps a readable measure; pictures take the room they need. */
  .prose {
    max-width: 1280px; margin-inline: auto;
    padding: clamp(64px, 8vw, 120px) var(--margin) 0;
    display: grid; gap: 1.2em; align-content: start;
  }
  .prose :global(p), .prose :global(li) { font-size: var(--step-lead); line-height: 1.5; }
  .prose > :global(p:not(:has(img))), .prose > :global(h2), .prose > :global(ul), .prose > :global(ol) { max-width: 62ch; }
  .prose :global(h2) {
    font-family: var(--display); font-weight: 400;
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 3rem); line-height: 1; text-wrap: balance;
  }
  .prose > :global(h2) { margin-top: clamp(40px, 5vw, 80px); }
  .prose :global(img) { width: 100%; height: auto; border-radius: calc(var(--radius) - 8px); }
  .prose :global(strong) { font-weight: 700; }
  .prose :global(ul:not(.swatches)) { list-style: disc; padding-left: 1.1em; display: grid; gap: 0.4em; }
  .prose :global(li::marker) { color: var(--lav-deep); }

  /* Pictures written one after another become a row. */
  .prose :global(p:has(img + img)) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(12px, 1.6vw, 24px); align-items: start; }
  .prose :global(p:has(> img:nth-of-type(3))) { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .prose :global(p:has(> img:nth-of-type(4))) { grid-template-columns: repeat(4, minmax(0, 1fr)); }

  /* <div class="split">: words on one side, a picture on the other. "flip" swaps them. */
  .prose :global(.split) {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: clamp(32px, 6vw, 96px);
    /* The two flexible rows centre the words beside the picture. */
    grid-template-rows: 1fr repeat(10, auto) 1fr;
    margin-top: clamp(40px, 5vw, 80px);
  }
  .prose :global(.split > *) { grid-column: 1; }
  .prose :global(.split > :where(:nth-child(1))) { grid-row: 2; }
  .prose :global(.split > :where(:nth-child(2))) { grid-row: 3; }
  .prose :global(.split > :where(:nth-child(3))) { grid-row: 4; }
  .prose :global(.split > :where(:nth-child(4))) { grid-row: 5; }
  .prose :global(.split > :where(:nth-child(5))) { grid-row: 6; }
  .prose :global(.split > * + *) { margin-top: 1em; }
  .prose :global(.split > p:has(img)) { grid-column: 2; grid-row: 1 / -1; margin-top: 0; align-self: center; }
  .prose :global(.split.flip > *) { grid-column: 2; }
  .prose :global(.split.flip > p:has(img)) { grid-column: 1; }
  .prose :global(.split.narrow > p:has(img)) { max-width: 360px; justify-self: center; }

  /* <div class="detti">: a saying, its picture and what it means. */
  .prose :global(.detti) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(24px, 3vw, 48px) clamp(12px, 1.6vw, 24px); margin-top: 0.5em; }
  .prose :global(.detti > div) { display: grid; gap: 6px; align-content: start; }
  .prose :global(.detti p) { font-size: var(--step-body); line-height: 1.4; }
  .prose :global(.detti p:has(img)) { margin-bottom: 8px; }
  .prose :global(.detti p + p + p) { color: var(--muted); }

  /* <ul class="swatches">: a palette in real colours. */
  .prose :global(.swatches) { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; max-width: 760px; }
  .prose :global(.swatches li) {
    background: var(--c); color: var(--t, #0d0d0f); border-radius: 18px; padding: 14px 16px 44px;
    font-size: var(--step-small); font-weight: 700; line-height: 1.3;
  }
  .prose :global(.swatches span) { display: block; font-weight: 400; opacity: 0.8; }

  .full { margin-top: clamp(24px, 3vw, 48px); }

  /* Next project: a tile as wide as the page, in that project's colour. */
  .next { margin-top: var(--gap-section); background: var(--tile); color: var(--tile-ink); }
  .next a {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr); gap: clamp(24px, 4vw, 72px); align-items: center;
    padding: clamp(40px, 6vw, 96px) var(--margin); text-decoration: none;
  }
  .next-text { display: grid; gap: 12px; }
  .next-title { font-size: clamp(3rem, 1rem + 7vw, 8rem); line-height: 0.9; transition: translate 300ms var(--ease); }
  .next-summary { max-width: 40ch; font-size: var(--step-lead); line-height: 1.4; }
  .next-pic { aspect-ratio: 16 / 10; border-radius: var(--radius); overflow: hidden; }
  .next-pic :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 600ms var(--ease); }
  .next a:hover .next-title { translate: 12px 0; }
  .next a:hover .next-pic :global(img) { transform: scale(1.05); }

  @media (max-width: 900px) {
    .head { grid-template-columns: 1fr; }
    .prose :global(.split), .prose :global(.split.flip) { grid-template-columns: 1fr; grid-template-rows: none; }
    .prose :global(.split > *) { grid-row: auto; }
    .prose :global(.split > *), .prose :global(.split.flip > *) { grid-column: 1; }
    .prose :global(.split > p:has(img)), .prose :global(.split.flip > p:has(img)) { grid-column: 1; grid-row: auto; margin-top: 1.2em; }
    .prose :global(p:has(> img:nth-of-type(3))) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .prose :global(.swatches) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .next a { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .prose :global(.detti) { grid-template-columns: 1fr; }
  }
</style>
