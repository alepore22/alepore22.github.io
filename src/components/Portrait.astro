---
// The self-portrait, traced to vector from the original drawing.
// The eyes are separate paths so they can follow the visitor's pointer.
import svg from '../assets/portrait.svg?raw';

interface Props { class?: string; live?: boolean }
const { class: className, live = false } = Astro.props;
---

<div class:list={['portrait', className]} data-portrait={live ? '' : undefined} set:html={svg} />

<style>
  .portrait { color: var(--ink); }
  .portrait :global(svg) { width: 100%; height: 100%; }
  .portrait :global(.eye) { transition: transform 260ms var(--ease); }
</style>

<script>
  const MAX = 30; // in drawing units: a few pixels on screen
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const portraits = document.querySelectorAll<HTMLElement>('[data-portrait]');

  if (!reduce && portraits.length) {
    const look = (x: number, y: number) => {
      portraits.forEach((p) => {
        const r = p.getBoundingClientRect();
        // The eyes sit at about 52% across and 46% down the drawing.
        const dx = x - (r.left + r.width * 0.52);
        const dy = y - (r.top + r.height * 0.46);
        const d = Math.hypot(dx, dy) || 1;
        const k = Math.min(1, d / 240);
        const tx = (dx / d) * MAX * k;
        const ty = (dy / d) * MAX * k * 0.7;
        p.querySelectorAll<SVGElement>('.eye').forEach((e) => {
          e.style.transform = `translate(${tx.toFixed(1)}px, ${ty.toFixed(1)}px)`;
        });
      });
    };
    let frame = 0;
    window.addEventListener('pointermove', (ev) => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => look(ev.clientX, ev.clientY));
    }, { passive: true });
    window.addEventListener('pointerdown', (ev) => look(ev.clientX, ev.clientY), { passive: true });
  }
</script>
