---
import '../styles/global.css';
import { site } from '../site';

interface Props {
  title?: string;
  description?: string;
  /** Background behind the navigation bar, to sit on the first section's colour. */
  barTone?: string;
  /** Text colour of the navigation bar. */
  barInk?: string;
  /** Background behind the footer strip, to continue the last section's colour. */
  footTone?: string;
}

const {
  title = `${site.name}, ${site.role}`,
  description = `${site.name}, ${site.role} a ${site.city}. App, UI/UX, grafica e illustrazione.`,
  barTone = 'var(--cream)',
  barInk = 'var(--ink)',
  footTone = 'var(--cream)',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#aa80ff" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">Vai al contenuto</a>
    <header class="bar" style={`background:${barTone};color:${barInk}`}>
      <a class="wordmark display" href="/" aria-label={`${site.nickname}, home`}>{site.nickname}</a>
      <nav aria-label="Principale">
        <ul>
          <li><a href="/#work">Progetti</a></li>
          <li><a href="/#about">Chi sono</a></li>
          <li><a href="/#contact">Contatti</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot" style={`background:${footTone}`}>
      <p>{site.season}</p>
      <p class="foot-mid">{site.name} · {site.role} · {site.city}</p>
      <p class="foot-end display">{site.nickname}</p>
    </footer>

    <script>
      // Each section's parts rise in turn, once, as it comes into view.
      const groups = document.querySelectorAll<HTMLElement>('[data-reveal]');
      groups.forEach((g) => [...g.children].forEach((c, i) => (c as HTMLElement).style.setProperty('--i', String(i))));
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
          }),
          { rootMargin: '0px 0px -8% 0px' },
        );
        groups.forEach((g) => io.observe(g));
      } else {
        groups.forEach((g) => g.classList.add('is-in'));
      }
    </script>
  </body>
</html>

<style>
  .bar {
    display: flex; justify-content: space-between; align-items: center;
    padding: 24px var(--margin);
  }
  .wordmark { font-size: 1.75rem; text-decoration: none; line-height: 1; }
  .bar ul { display: flex; gap: 28px; font-weight: 600; font-size: var(--step-small); }
  .bar ul a { text-decoration: none; }
  .bar ul a:hover { text-decoration: underline; }

  .foot {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: baseline; gap: 24px;
    padding: 28px var(--margin);
    font-size: var(--step-small); font-weight: 600;
  }
  .foot-mid { font-weight: 400; }
  .foot-end { text-align: right; font-size: 1.25rem; }

  @media (max-width: 720px) {
    .bar ul { gap: 16px; }
    .foot { grid-template-columns: 1fr auto; }
    .foot-mid { display: none; }
  }
</style>
