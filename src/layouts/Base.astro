---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { site } from '../site';

interface Props {
  title?: string;
  description?: string;
  /** Colours of the navigation bar while it sits on the first section. */
  barTone?: string;
  barInk?: string;
  /** Background behind the footer, to continue the last section's colour. */
  footTone?: string;
  footInk?: string;
  /** Which navigation link is the current one on pages without sections to follow. */
  current?: 'work' | 'about' | 'contact';
}

const {
  title = `${site.name}, ${site.role}`,
  description = `${site.name}, ${site.role} a ${site.city}. App, UI/UX, grafica e illustrazione.`,
  barTone = 'var(--cream)',
  barInk = 'var(--ink)',
  footTone = 'var(--cream)',
  footInk = 'var(--ink)',
  current,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const year = new Date().getFullYear();
const nav = [
  { id: 'work', label: 'Progetti' },
  { id: 'about', label: 'Chi sono' },
  { id: 'contact', label: 'Contatti' },
] as const;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#aa80ff" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <ClientRouter />
    <script is:inline>
      document.documentElement.classList.add('js');
      document.addEventListener('astro:after-swap', () => document.documentElement.classList.add('js'));
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Vai al contenuto</a>
    <header class="bar" data-bar style={`--bar-bg:${barTone};--bar-ink:${barInk}`}>
      <a class="wordmark display" href="/" aria-label={`${site.nickname}, home`}>{site.nickname}</a>
      <nav aria-label="Principale">
        <ul>
          {nav.map((n) => (
            <li><a href={`/#${n.id}`} data-nav={n.id} aria-current={current === n.id ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot" style={`background:${footTone};color:${footInk}`}>
      <p>© {year} {site.name}</p>
      <ul>
        {nav.map((n) => <li><a href={`/#${n.id}`}>{n.label}</a></li>)}
      </ul>
      <p class="foot-end"><a href="#main">Torna su</a></p>
    </footer>

    <script>
      const setup = () => {
        // Each section's parts rise in turn, once, as it comes into view.
        const groups = document.querySelectorAll<HTMLElement>('[data-reveal]');
        groups.forEach((g) => [...g.children].forEach((c, i) => (c as HTMLElement).style.setProperty('--i', String(i))));
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
          }),
          { rootMargin: '0px 0px -8% 0px' },
        );
        groups.forEach((g) => io.observe(g));

        // On the home page the navigation follows the section on screen.
        const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav]')];
        const sections = links.map((a) => document.getElementById(a.dataset.nav!)).filter((s): s is HTMLElement => !!s);
        if (sections.length) {
          const spy = new IntersectionObserver(
            (entries) => entries.forEach((e) => {
              const link = links.find((a) => a.dataset.nav === e.target.id);
              if (e.isIntersecting) links.forEach((a) => a.toggleAttribute('aria-current', a === link));
              else link?.removeAttribute('aria-current');
            }),
            { rootMargin: '-45% 0px -50% 0px' },
          );
          sections.forEach((s) => spy.observe(s));
        }
        stick();
      };

      // The bar takes the page colour once it leaves the first section.
      const stick = () => document.querySelector('[data-bar]')?.classList.toggle('is-stuck', window.scrollY > 24);
      window.addEventListener('scroll', stick, { passive: true });
      document.addEventListener('astro:page-load', setup);
    </script>
  </body>
</html>

<style>
  .bar {
    position: sticky; top: 0; z-index: 20;
    display: flex; justify-content: space-between; align-items: center;
    padding: 20px var(--margin);
    --bg: var(--bar-bg); --fg: var(--bar-ink);
    background: var(--bg); color: var(--fg);
    transition: background-color 240ms var(--ease), color 240ms var(--ease), padding 240ms var(--ease);
  }
  .bar:global(.is-stuck) { --bg: var(--cream); --fg: var(--ink); padding-block: 12px; }
  .wordmark { font-size: 1.75rem; text-decoration: none; line-height: 1; transition: rotate 200ms var(--ease); }
  .wordmark:hover { rotate: -4deg; }
  .bar ul { display: flex; gap: 6px; font-weight: 600; font-size: var(--step-small); }
  .bar ul a {
    display: block; padding: 8px 14px; border-radius: 999px; text-decoration: none;
    transition: background-color 180ms var(--ease), color 180ms var(--ease);
  }
  .bar ul a:hover { background: color-mix(in srgb, currentColor 12%, transparent); }
  .bar ul a[aria-current] { background: var(--fg); color: var(--bg); }

  .foot {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 24px;
    padding: 28px var(--margin);
    font-size: var(--step-small); font-weight: 600;
  }
  .foot ul { display: flex; gap: 24px; }
  .foot a { text-decoration: none; }
  .foot a:hover { text-decoration: underline; }
  .foot-end { text-align: right; }

  @media (max-width: 720px) {
    .bar ul { gap: 0; }
    .bar ul a { padding: 8px 10px; }
    .foot { grid-template-columns: 1fr auto; }
    .foot ul { display: none; }
  }
</style>
