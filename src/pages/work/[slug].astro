---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: work[(i + 1) % work.length] },
  }));
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<Base title={`${d.title}, ${d.kind} by Angelo Lepore`} description={d.summary}>
  <article class="project">
    <header class="head" data-reveal>
      <h1>{d.title}</h1>
      <p class="summary">{d.summary}</p>
    </header>

    <figure class="cover" data-reveal>
      <Image src={d.cover} alt={d.coverAlt} widths={[400, 808]} sizes="(max-width: 900px) 100vw, 808px" loading="eager" />
    </figure>

    <div class="body">
      <dl class="meta" data-reveal>
        <div><dt>Year</dt><dd>{d.year}</dd></div>
        <div><dt>Kind</dt><dd>{d.kind}</dd></div>
        {d.role && <div><dt>Role</dt><dd>{d.role}</dd></div>}
        {d.with && <div><dt>With</dt><dd>{d.with}</dd></div>}
        {d.tools.length > 0 && <div><dt>Tools</dt><dd>{d.tools.join(', ')}</dd></div>}
      </dl>
      <div class="prose" data-reveal>
        <h2 class="prose-title">The project</h2>
        <Content />
        {d.behance && <p class="full"><a class="text-link" href={d.behance}>The full case study on Behance</a></p>}
      </div>
    </div>

    <nav class="next" aria-label="Next project" data-reveal>
      <h2 class="next-label">Next project</h2>
      <a href={`/work/${next.id}/`}>{next.data.title}</a>
      <p class="back"><a href="/#work">Back to all work</a></p>
    </nav>
  </article>
</Base>

<style>
  .project { padding: clamp(40px, 10vh, 120px) var(--margin) 0; }
  .head { padding-left: calc(var(--col) - var(--margin)); max-width: calc(var(--col) + 760px); }
  .back { margin-top: 24px; font-size: var(--step-small); }
  .back:hover { color: var(--accent); }
  h1 {
    font-size: var(--step-hero); text-wrap: balance; font-weight: 300; letter-spacing: -0.035em; line-height: 1.02;
  }
  .summary { margin-top: 28px; max-width: 40ch; font-size: var(--step-lead); line-height: 1.4; }

  .cover { margin-top: clamp(56px, 8vw, 112px); background: var(--surface); padding: clamp(0px, 4vw, 64px); }
  .cover :global(img) { width: 100%; max-width: 808px; margin-inline: auto; }

  .body {
    display: grid; grid-template-columns: calc(var(--col) - var(--margin) - 48px) minmax(0, 1fr);
    gap: 48px; margin-top: clamp(56px, 8vw, 112px);
  }
  .meta { display: grid; gap: 18px; font-size: var(--step-small); align-content: start; position: sticky; top: 32px; }
  .meta dt { color: var(--muted); }
  .prose { display: grid; gap: 1.2em; align-content: start; }
  .prose > :global(*:not(:has(img))) { max-width: 62ch; }
  .prose :global(h2) { font-size: var(--step-lead); font-weight: 500; margin-top: 1.6em; }
  .prose :global(p:has(img)) { margin: 1.2em 0; background: var(--surface); }
  .prose :global(img) { width: 100%; height: auto; }
  /* Several pictures in one paragraph become a grid (the wallpapers). */
  .prose :global(p:has(img + img)) {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(12px, 1.6vw, 24px);
    background: none;
  }
  .prose .prose-title { margin-top: 0; }
  .full { margin-top: 1em; }

  .next { margin-top: var(--gap-section); padding-left: calc(var(--col) - var(--margin)); }
  .next-label { font-size: var(--step-small); font-weight: 400; color: var(--muted); }
  .next > a {
    display: inline-block; margin-top: 8px; text-decoration: none;
    font-size: var(--step-display); font-weight: 300; letter-spacing: -0.035em; line-height: 1.05;
    transition: color 180ms var(--ease), transform 300ms var(--ease);
  }
  .next > a:hover { color: var(--accent); transform: translateX(8px); }

  @media (max-width: 1100px) {
    .head, .next { padding-left: 0; }
    .body { grid-template-columns: 160px minmax(0, 1fr); }
  }
  @media (max-width: 720px) {
    .body { grid-template-columns: 1fr; gap: 32px; }
    .meta { grid-template-columns: 1fr 1fr; position: static; }
    .prose :global(p:has(img + img)) { grid-template-columns: 1fr; }
  }
</style>
