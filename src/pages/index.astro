---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Portrait from '../components/Portrait.astro';
import Arrow from '../components/Arrow.astro';
import DemonSwarm from '../components/DemonSwarm.astro';
import { site } from '../site';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const numbers = ['zero', 'un', 'due', 'tre', 'quattro', 'cinque', 'sei', 'sette', 'otto', 'nove', 'dieci', 'undici', 'dodici'];
const count = numbers[work.length] ?? String(work.length);
const mail = `mailto:${site.email}?subject=${encodeURIComponent('Ciao Angelo')}`;
const filters = [
  { id: 'tutti', label: 'Tutti' },
  { id: 'uiux', label: 'UI/UX' },
  { id: 'grafica', label: 'Grafica e illustrazione' },
  { id: 'app', label: 'App con Claude Code' },
];
const ticker = ['UI/UX design', 'Illustrazione', 'Grafica', 'App iOS', 'Napoli'];
---

<Base barTone="var(--lav)" footTone="var(--lav)">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-text" data-reveal>
      <h1 id="hero-title" class="display">Hello There!</h1>
      <p class="hand hero-note">This is where fun begins
        <svg class="smile" viewBox="0 0 32 32" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><circle cx="16" cy="16" r="13"/><path d="M10 18c3 4 9 4 12 0M11.5 12.5h.1M20.5 12.5h.1"/></svg>
      </p>
      <p class="lead">
        Sono <strong>Angelo Lepore</strong>, {site.role} a {site.city}.
        Disegno per rendere le cose più chiare, più umane e, quando va bene, un po’ più felici.
      </p>
      <p class="actions">
        <a class="button" href="#work">Guarda i progetti</a>
        <a class="text-link" href="#contact">Scrivimi</a>
      </p>
    </div>
    <div class="hero-portrait">
      <Portrait live />
    </div>
  </section>

  <!-- What he does, running past. -->
  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      {[0, 1].map(() => (
        <ul>
          {ticker.map((t) => (
            <li class="display">{t}<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c1 7 4 10 12 12-8 2-11 5-12 12-1-7-4-10-12-12 8-2 11-5 12-12z"/></svg></li>
          ))}
        </ul>
      ))}
    </div>
  </div>

  <section id="work" class="work" aria-labelledby="work-title">
    <div class="work-head" data-reveal>
      <h2 id="work-title" class="display work-title">
        Ecco <span class="lav">{count}</span> progetti che raccontano come lavoro
      </h2>
      <p class="hand work-note">Spoiler: nessuno è perfetto,<br />ma tutti mi hanno lasciato qualcosa.</p>
    </div>

    <div class="filters" role="group" aria-label="Filtra i progetti" data-filters>
      {filters.map((f, i) => (
        <button type="button" data-group={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label}</button>
      ))}
    </div>

    <ul class="bento" data-bento data-filter="tutti">
      {work.map((w, i) => (
        <li
          class={`tile tile-${i + 1}`}
          data-group={w.data.group}
          style={`--tile:${w.data.color};--tile-ink:${w.data.ink};view-transition-name:tile-${w.id}`}
        >
          <a href={`/work/${w.id}/`}>
            <span class:list={['tile-pic', { 'tile-pic--video': w.data.video }]} transition:name={`media-${w.id}`}>
              {w.id === 'demons' ? (
                <DemonSwarm />
              ) : w.data.video ? (
                <video src={w.data.video} poster={w.data.cover.src} autoplay muted loop playsinline preload="metadata" aria-label={w.data.coverAlt} />
              ) : (
                <Image
                  src={w.data.cover}
                  alt={w.data.coverAlt}
                  widths={[480, 800, 1200, 1600]}
                  sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 66vw"
                  style={`object-position:${w.data.coverPosition}`}
                />
              )}
            </span>
            <span class="tile-foot">
              <span class="tile-title display">{w.data.title}</span>
              <span class="tile-meta">{w.data.category} · {w.data.date}</span>
              <span class="tile-more"><span class="tile-summary">{w.data.summary}</span></span>
            </span>
            <span class="tile-go" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 18 18 6M8 6h10v10"/></svg>
            </span>
            {w.data.note && <span class="tile-note hand">{w.data.note}</span>}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section id="about" class="about" aria-labelledby="about-title">
    <div class="about-pic" data-reveal>
      <div class="about-frame"><Portrait live /></div>
      <p class="hand about-quote">Do or do not.<br />There is no try.</p>
    </div>
    <div class="about-text" data-reveal>
      <h2 id="about-title" class="display about-title">Io sono Angelo</h2>
      <p>
        Per molti anche Lepo o Angolo, sono cresciuto tra matite e maratone di Star Wars.
        Mi muovo tra UI/UX, grafica e illustrazione, cercando sempre quell’equilibrio magico tra
        funzionalità e sorriso: perché se un design non ti fa dire “Uà”, allora non hai ancora finito il tuo lavoro.
      </p>
      <p>
        Sono fermamente convinto che anche i progetti più seri abbiano bisogno di leggerezza.
        Mi piace far ridere e raccontare attraverso forme e colori, senza troppe pose da “guru del design”.
      </p>
      <dl class="facts">
        <div><dt>Base</dt><dd>{site.city}</dd></div>
        <div><dt>Lavoro con</dt><dd>{site.company}</dd></div>
        <div><dt>Faccio</dt><dd>UI/UX, grafica, illustrazione e app</dd></div>
      </dl>
    </div>
  </section>

  <section id="contact" class="contact" aria-labelledby="contact-title">
    <div class="contact-head" data-reveal>
      <h2 id="contact-title" class="display contact-title">End of transmission.</h2>
      <p class="hand contact-way">This is the way</p>
    </div>
    <ul class="contact-links" data-reveal>
      <li>
        <p class="hand">Scrivimi qui</p>
        <Arrow down />
        <a href={mail}>{site.email}</a>
        <button type="button" class="copy" data-copy={site.email}>Copia l’indirizzo</button>
      </li>
      <li>
        <p class="hand">Qui per collegarti con me</p>
        <Arrow flip down />
        <a href={site.links.linkedin}>LinkedIn</a>
      </li>
      <li>
        <p class="hand">Qui altre cose molto carine</p>
        <Arrow down />
        <span class="pair"><a href={site.links.behance}>Behance</a> <a href={site.links.instagram}>Instagram</a></span>
      </li>
    </ul>
  </section>
</Base>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.addEventListener('astro:page-load', () => {
    // Filters: show one family of projects, and let the tiles slide to their new places.
    const bar = document.querySelector<HTMLElement>('[data-filters]');
    const grid = document.querySelector<HTMLElement>('[data-bento]');
    if (bar && grid) {
      bar.addEventListener('click', (ev) => {
        const button = (ev.target as HTMLElement).closest('button');
        if (!button) return;
        const group = button.dataset.group!;
        const apply = () => {
          bar.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
          grid.dataset.filter = group;
          grid.querySelectorAll<HTMLElement>('.tile').forEach((t) => { t.hidden = group !== 'tutti' && t.dataset.group !== group; });
        };
        if (document.startViewTransition && !reduce.matches) document.startViewTransition(apply);
        else apply();
      });
    }

    // Copy the email address.
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
      const label = b.textContent;
      b.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(b.dataset.copy!);
          b.textContent = 'Copiato!';
        } catch {
          b.textContent = b.dataset.copy!;
        }
        setTimeout(() => { b.textContent = label; }, 1800);
      });
    });
  });
</script>

<style>
  .lav { color: #9566ff; }
  .smile { display: inline-block; width: 1.1em; vertical-align: -0.2em; margin-left: 4px; }

  /* Hero */
  .hero {
    background: var(--lav);
    display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: center; gap: clamp(24px, 4vw, 64px);
    padding: clamp(16px, 4vh, 56px) var(--margin) clamp(48px, 8vh, 96px);
    min-height: calc(100svh - 150px);
  }
  .hero h1 { font-size: var(--step-hero); line-height: 0.9; letter-spacing: -0.02em; }
  .hero-note { margin-top: 12px; text-align: right; max-width: 10.5em; margin-left: auto; margin-right: 6%; }
  .hero-text { display: flex; flex-direction: column; }
  .lead { margin-top: clamp(28px, 4vh, 48px); max-width: 34ch; font-size: var(--step-lead); line-height: 1.4; }
  .actions { margin-top: 28px; display: flex; align-items: center; gap: 28px; flex-wrap: wrap; }
  .hero-portrait { max-width: 540px; justify-self: center; width: 100%; }

  /* Ticker */
  .ticker { background: var(--ink); color: var(--cream); overflow: hidden; padding: 14px 0; }
  .ticker-track { display: flex; width: max-content; animation: run 36s linear infinite; }
  .ticker ul { display: flex; flex: none; }
  .ticker li { display: flex; align-items: center; gap: 28px; padding-right: 28px; font-size: clamp(1.25rem, 1rem + 1vw, 2rem); line-height: 1; white-space: nowrap; }
  .ticker svg { width: 0.6em; color: var(--lav); }
  @keyframes run { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .ticker-track { animation: none; } }

  /* Work */
  .work { padding: var(--gap-section) var(--margin) 0; scroll-margin-top: 40px; }
  .work-head { display: grid; gap: 20px; }
  .work-title { font-size: clamp(2.25rem, 1rem + 4.2vw, 5rem); text-transform: uppercase; line-height: 0.95; text-wrap: balance; }
  .work-note { color: var(--muted); justify-self: end; text-align: right; margin-right: 4%; }

  .filters { margin-top: clamp(32px, 4vw, 56px); display: flex; flex-wrap: wrap; gap: 8px; }
  .filters button {
    font: 600 var(--step-small)/1 var(--text); color: var(--ink);
    padding: 12px 18px; border: 0; border-radius: 999px; cursor: pointer;
    background: #f3e4d9;
    transition: background-color 180ms var(--ease), color 180ms var(--ease), transform 140ms var(--ease);
  }
  .filters button:hover { background: #ead6c8; }
  .filters button:active { transform: scale(0.96); }
  .filters button[aria-pressed='true'] { background: var(--ink); color: var(--cream); }

  .bento {
    margin-top: 24px;
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: clamp(170px, 16vw, 250px);
    grid-auto-flow: dense;
    gap: clamp(12px, 1.4vw, 20px);
  }
  .tile { grid-row: span 2; grid-column: span 4; }
  .tile[hidden] { display: none; }
  .tile-1 { grid-column: span 8; }
  .tile-4 { grid-column: span 8; }
  /* With a filter on, the tiles that are left share the row evenly. */
  .bento:not([data-filter='tutti']) .tile { grid-column: span 6; }
  .bento[data-filter='uiux'] .tile { grid-column: span 4; }

  .tile a {
    position: relative; display: flex; flex-direction: column; height: 100%;
    background: var(--tile); color: var(--tile-ink);
    border-radius: var(--radius); padding: 10px; text-decoration: none; overflow: hidden;
    transition: transform 260ms var(--ease);
  }
  .tile-pic { flex: 1; min-height: 0; border-radius: calc(var(--radius) - 10px); overflow: hidden; display: block; }
  .tile-pic :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 600ms var(--ease); }
  .tile-pic--video { display: grid; place-items: center; padding: 6px 0; }
  .tile-pic video { height: 100%; width: auto; max-width: 100%; border-radius: 22px; }
  .tile-foot { display: grid; grid-template-columns: 1fr auto; align-items: baseline; gap: 0 16px; padding: 14px 56px 6px 12px; }
  .tile-title { font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.25rem); line-height: 1; }
  .tile-meta { font-size: var(--step-small); font-weight: 600; }
  /* The summary opens under the title when the tile is pointed at. */
  .tile-more { grid-column: 1 / -1; display: grid; grid-template-rows: 0fr; transition: grid-template-rows 320ms var(--ease); }
  .tile-summary { overflow: hidden; font-size: var(--step-small); line-height: 1.4; max-width: 52ch; }
  .tile-summary::before { content: ''; display: block; height: 8px; }
  .tile a:hover .tile-more, .tile a:focus-visible .tile-more { grid-template-rows: 1fr; }
  .tile-go {
    position: absolute; right: 18px; bottom: 16px; width: 40px; height: 40px; border-radius: 50%;
    display: grid; place-items: center; background: var(--tile-ink); color: var(--tile);
    transition: transform 260ms var(--ease);
  }
  .tile-go svg { width: 18px; }
  .tile a:hover .tile-go { transform: rotate(45deg) scale(1.1); }
  .tile-note {
    position: absolute; top: 22px; right: 22px; transform: rotate(-4deg);
    background: var(--cream); color: var(--ink); padding: 6px 12px 4px; border-radius: 10px;
    font-size: 1.125rem;
  }
  .tile a:hover { transform: translateY(-4px); }
  .tile a:hover .tile-pic :global(img) { transform: scale(1.04); }
  @media (hover: none) {
    .tile-more { grid-template-rows: 1fr; }
  }

  /* About */
  .about {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: clamp(40px, 6vw, 120px); align-items: center;
    padding: var(--gap-section) var(--margin) 0; scroll-margin-top: 40px;
  }
  .about-pic { display: flex; flex-direction: column; align-items: center; gap: 20px; }
  .about-frame { width: min(100%, 460px); aspect-ratio: 1; background: #fff; border-radius: 50%; padding: 9%; }
  .about-quote { color: var(--lav-deep); text-align: center; }
  .about-text { display: grid; gap: 1.1em; max-width: 60ch; }
  .about-title { font-size: clamp(2.75rem, 1.6rem + 4vw, 5.5rem); margin-bottom: 0.2em; }
  .about-text > p { font-size: var(--step-lead); line-height: 1.5; }
  .facts { display: grid; grid-template-columns: repeat(3, auto); justify-content: start; gap: 12px 40px; margin-top: 1em; font-size: var(--step-small); }
  .facts dt { color: var(--muted); }
  .facts dd { font-weight: 600; }

  /* Contact */
  .contact {
    margin-top: var(--gap-section);
    background: var(--lav);
    padding: clamp(80px, 12vw, 176px) var(--margin) clamp(48px, 6vw, 96px);
  }
  .contact-head { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .contact-title { font-size: clamp(3rem, 1rem + 8vw, 10rem); line-height: 0.9; }
  .contact-way { align-self: flex-end; margin-right: 12%; margin-top: 10px; }
  .contact-links {
    margin-top: clamp(64px, 9vw, 128px);
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; align-items: start;
  }
  .contact-links li { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 8px; }
  .contact-links :global(.arrow) { color: var(--ink); }
  .contact-links a { font-weight: 700; font-size: var(--step-lead); word-break: break-word; }
  .contact-links a:hover { color: var(--cream); }
  .copy {
    margin-top: 6px; font: 600 var(--step-small)/1 var(--text); color: var(--cream);
    background: var(--ink); border: 0; border-radius: 999px; padding: 10px 16px; cursor: pointer;
    transition: transform 140ms var(--ease);
  }
  .copy:hover { transform: translateY(-2px); }
  .copy:active { transform: scale(0.96); }
  .pair { display: flex; gap: 20px; }

  @media (max-width: 1100px) {
    .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: clamp(200px, 30vw, 300px); }
    .bento .tile, .bento:not([data-filter='tutti']) .tile { grid-column: span 1; }
    .bento .tile-1 { grid-column: span 2; }
  }

  @media (max-width: 800px) {
    .hero { grid-template-columns: 1fr; min-height: 0; padding-top: 16px; }
    .hero-portrait { max-width: 300px; order: -1; }
    .hero-note { margin-right: 0; }
    .about { grid-template-columns: 1fr; }
    .about-frame { width: min(100%, 300px); }
    .facts { grid-template-columns: 1fr 1fr; }
    .contact-links { grid-template-columns: 1fr; gap: 48px; }
  }

  @media (max-width: 640px) {
    .bento { grid-template-columns: 1fr; grid-auto-rows: auto; }
    .bento .tile, .bento .tile-1 { grid-column: span 1; grid-row: auto; }
    .tile-pic { flex: none; aspect-ratio: 4 / 3; }
  }
</style>
