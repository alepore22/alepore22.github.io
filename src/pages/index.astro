---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Portrait from '../components/Portrait.astro';
import doorInterfaces from '../assets/covers/weitoyou.webp';
import { site } from '../site';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const groups = [
  { id: 'interfaces', name: 'Interfaces', items: work.filter((w) => w.data.field === 'interfaces') },
  { id: 'illustration', name: 'Illustration', items: work.filter((w) => w.data.field === 'illustration') },
];
const mail = `mailto:${site.email}?subject=${encodeURIComponent('Hello Angelo')}`;
---

<Base>
  <section class="hero" aria-labelledby="hero-title">
    <h1 id="hero-title">Angelo Lepore draws interfaces and&nbsp;people.</h1>
    <div class="hero-text" data-reveal>
      <p class="lead">{site.role[0].toUpperCase() + site.role.slice(1)} from {site.city}, designing at {site.company}.</p>
      <p class="actions">
        <a class="button" href={mail}>Write to me</a>
        <a class="text-link" href="#work">See the work</a>
      </p>
    </div>

    <ul class="doors" data-reveal>
      <li class="door">
        <a href="#interfaces">
          <span class="door-frame">
            <Image class="door-img--ui" src={doorInterfaces} alt="Phone screens from the WeiToYou app, joined by a red thread." widths={[400, 808]} sizes="280px" loading="eager" />
          </span>
          <span class="door-name">Interfaces</span>
          <span class="door-line">Apps and case studies, made in Figma.</span>
        </a>
      </li>
      <li class="door">
        <a href="#illustration">
          <span class="door-frame door-frame--portrait">
            <Portrait live />
          </span>
          <span class="door-name">Illustration</span>
          <span class="door-line">Line drawings, like this one of me.</span>
        </a>
      </li>
    </ul>
  </section>

  <section id="work" class="work" aria-labelledby="work-title">
    <h2 id="work-title" class="section-title">Selected work</h2>
    {groups.map((g) => (
      <div class="ledger-group" id={g.id} data-reveal>
        <h3 class="group-title">{g.name}</h3>
        <ul class="ledger">
          {g.items.map((w) => (
            <li class="row">
              <a href={`/work/${w.id}/`}>
                <span class="row-pic">
                  <Image src={w.data.cover} alt={w.data.coverAlt} widths={[480, 800]} sizes="(max-width: 720px) 100vw, 320px" />
                </span>
                <span class="row-name">{w.data.title}</span>
                <span class="row-kind">{w.data.kind}</span>
                <span class="row-year">{w.data.year}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  <section id="about" class="about" aria-labelledby="about-title">
    <h2 id="about-title" class="section-title">About</h2>
    <div class="about-row" data-reveal>
      <dl class="facts">
        <div><dt>Based in</dt><dd>{site.city}</dd></div>
        <div><dt>Works at</dt><dd>{site.company}</dd></div>
        <div><dt>Does</dt><dd>UI design, illustration</dd></div>
      </dl>
      <p class="about-text">
        I’m Angelo. I design apps the same way I draw people: one steady line at a time,
        rounding every corner, until nothing is left that doesn’t need to be there.
        Some days that line ends up in Figma, other days on a wallpaper.
      </p>
    </div>
    <div class="about-row about-row--record" data-reveal>
      <p class="record-label">Elsewhere</p>
      <ul class="record">
        <li><a href={site.links.behance}>Behance</a><span>angelolepore</span></li>
        <li><a href={site.links.instagram}>Instagram</a><span>leposhow</span></li>
        <li><a href={site.links.linkedin}>LinkedIn</a><span>leposhow</span></li>
      </ul>
    </div>
  </section>

  <section id="contact" class="contact" aria-labelledby="contact-title">
    <div class="contact-row" data-reveal>
      <p class="contact-say">Got an app that needs a careful interface, or a wall that needs a drawing? Tell me about&nbsp;it.</p>
      <div class="contact-pic"><Portrait /></div>
      <div class="contact-links">
        <h2 id="contact-title" class="contact-q">Starting a project?</h2>
        <a class="mail" href={mail}>{site.email}</a>
        <a href={site.links.linkedin}>LinkedIn</a>
        <p class="contact-where">{site.city}</p>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero: headline on the column line, two doors that lead to the two halves of the work. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: clamp(32px, 6vw, 96px);
    row-gap: clamp(40px, 6vh, 72px);
    align-items: start;
    padding: clamp(32px, 9vh, 112px) var(--margin) 0 var(--col);
  }
  .hero h1 {
    grid-column: 1 / -1;
    font-size: var(--step-hero);
    font-weight: 300;
    letter-spacing: -0.035em;
    line-height: 1;
    text-wrap: balance;
  }
  .lead { max-width: 30ch; font-size: var(--step-lead); line-height: 1.4; }
  .actions { margin-top: 40px; display: flex; align-items: center; gap: 28px; flex-wrap: wrap; }

  .doors { display: flex; gap: clamp(20px, 3vw, 48px); }
  .door a { display: block; text-decoration: none; width: clamp(200px, 17vw, 280px); }
  .door-frame {
    display: block; aspect-ratio: 3 / 4; overflow: hidden; background: var(--surface);
    transition: opacity 220ms var(--ease);
  }
  .door-frame :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 500ms var(--ease); }
  .door-frame :global(.door-img--ui) { object-position: 88% 50%; }
  .door-frame--portrait { display: grid; place-items: center; padding: 14%; }
  .door-name { display: block; margin-top: 16px; font-size: var(--step-lead); line-height: 1.2; }
  .door-line { display: block; margin-top: 4px; color: var(--muted); font-size: var(--step-small); }
  .doors:has(a:hover, a:focus-visible) .door a:not(:hover, :focus-visible) .door-frame { opacity: 0.5; }
  .door a:hover .door-frame :global(img) { transform: scale(1.03); }

  /* Shared section heading */
  .section-title { font-size: var(--step-head); font-weight: 400; letter-spacing: -0.02em; line-height: 1.1; }

  /* Work: a quiet ledger on the column line, picture appears beside the row. */
  .work { padding: var(--gap-section) var(--margin) 0 var(--col); position: relative; }
  .ledger-group { margin-top: 56px; max-width: var(--col-w); position: relative; }
  .group-title { font-size: var(--step-body); font-weight: 500; margin-bottom: 8px; }
  .row a {
    display: grid;
    grid-template-columns: 55% 1fr auto;
    align-items: baseline;
    min-height: 48px;
    padding: 10px 0;
    text-decoration: none;
    transition: color 180ms var(--ease);
  }
  .row-name { font-size: var(--step-lead); line-height: 1.2; }
  .row-kind { color: var(--muted); font-size: var(--step-small); }
  .row-year { font-variant-numeric: tabular-nums; font-size: var(--step-small); }
  .row-pic {
    position: absolute; left: calc(100% + 64px); top: 0;
    width: clamp(260px, 24vw, 380px); aspect-ratio: 4 / 3;
    opacity: 0; pointer-events: none; transform: translateY(8px);
    transition: opacity 180ms var(--ease), transform 300ms var(--ease);
  }
  .row-pic :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .row { position: static; }
  .ledger:has(a:hover, a:focus-visible) .row a:not(:hover, :focus-visible) { color: var(--muted); }
  .ledger:has(a:hover, a:focus-visible) .row a:not(:hover, :focus-visible) .row-year { color: var(--muted); }
  .row a:hover .row-pic, .row a:focus-visible .row-pic { opacity: 1; transform: none; }
  /* With nothing pointed at, the first picture of the group rests there so the right side is never empty. */
  .work:not(:has(.row a:hover, .row a:focus-visible)) .ledger-group:first-of-type .row:first-child .row-pic { opacity: 1; transform: none; }

  /* About: facts on the left, a wide paragraph from the 34% line. */
  .about { padding: var(--gap-section) var(--margin) 0 var(--col); }
  .about-row {
    display: grid; grid-template-columns: minmax(140px, 12vw) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 96px); margin-top: 56px; max-width: 1100px;
  }
  .facts { display: grid; gap: 20px; font-size: var(--step-small); }
  .facts dt { color: var(--muted); }
  .about-text { font-size: var(--step-lead); line-height: 1.4; max-width: 34ch; }
  .about-row--record { margin-top: 80px; align-items: baseline; }
  .record-label { font-size: var(--step-small); color: var(--muted); }
  .record { display: grid; grid-template-columns: repeat(3, minmax(0, 200px)); gap: 12px 48px; }
  .record li { display: flex; flex-direction: column; }
  .record a { font-weight: 500; }
  .record a:hover { color: var(--accent); }
  .record span { color: var(--muted); font-size: var(--step-small); }

  /* Contact: sentence, portrait, links hanging from one top line. */
  .contact { padding: var(--gap-section) var(--margin) 0; }
  .contact-row { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 24px; align-items: start; }
  .contact-say {
    grid-column: 1 / 6;
    font-size: clamp(1.5rem, 1rem + 1.4vw, 2.25rem); font-weight: 300;
    letter-spacing: -0.02em; line-height: 1.15;
  }
  .contact-pic { grid-column: 7 / 9; aspect-ratio: 1; background: var(--surface); padding: 12%; max-width: 180px; justify-self: end; width: 100%; }
  .contact-links { grid-column: 9 / 13; display: flex; flex-direction: column; align-items: flex-start; gap: 10px; font-size: var(--step-lead); }
  .contact-q { font: 500 var(--step-lead)/1.2 var(--font); margin-bottom: 10px; }
  .mail { color: var(--accent); word-break: break-all; }
  .mail:hover { color: var(--ink); }
  .contact-links a:not(.mail):hover { color: var(--accent); }
  .contact-where { margin-top: 10px; color: var(--muted); font-size: var(--step-small); }

  @media (max-width: 1100px) {
    .hero { grid-template-columns: 1fr; padding-left: var(--margin); }
    .work, .about { padding-left: var(--margin); }
    .row-pic { left: calc(100% + 40px); }
  }

  @media (max-width: 900px) {
    .ledger-group { max-width: none; }
    .row a { grid-template-columns: 1fr auto; grid-template-rows: auto auto; row-gap: 2px; }
    .row-pic {
      position: static; grid-column: 1 / -1; order: -1; width: 100%; aspect-ratio: 16 / 10;
      opacity: 1; transform: none; margin: 16px 0 12px;
    }
    .row-name { grid-column: 1; }
    .row-year { grid-column: 2; grid-row: 2; }
    .row-kind { grid-column: 1 / -1; grid-row: 3; }
    .ledger:has(a:hover, a:focus-visible) .row a:not(:hover, :focus-visible) { color: inherit; }
    .about-row { grid-template-columns: 1fr; }
    .about-text { order: -1; max-width: none; }
    .facts { grid-template-columns: repeat(3, auto); justify-content: start; gap: 12px 32px; }
    .record { grid-template-columns: repeat(3, auto); justify-content: start; }
    .contact-row { grid-template-columns: 96px 1fr; gap: 24px 20px; }
    .contact-say { grid-column: 1 / -1; }
    .contact-pic { grid-column: 1; justify-self: start; }
    .contact-links { grid-column: 2; }
  }

  @media (max-width: 560px) {
    .doors { gap: 14px; }
    .door { flex: 1; }
    .door a { width: 100%; }
    .door-name { font-size: var(--step-body); margin-top: 10px; }
    .facts { grid-template-columns: 1fr 1fr; }
    .record { grid-template-columns: 1fr 1fr; }
  }
</style>
